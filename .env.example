VITE_API_BASE_URL=http://localhost:8000/api/v1

# Error reporting (optional): create a Sentry project and paste its DSN; off while empty.
# Reports never include tokens from reset/verification links or OAuth parameters (src/lib/sentry.ts).
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=production

# "Try the demo" on the landing page; the API must have DEMO_ENABLED=true too.
# VITE_DEMO_ENABLED=true
